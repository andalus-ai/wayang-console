DB_USERNAME=wayang_console
DB_PASSWORD=change-me-locally
DB_JDBC_URL=jdbc:postgresql://localhost:5432/wayang_console

# Required by the production profile. Use the issuer/realm base URL, not the
# discovery or JWKS endpoint URL. Never put client secrets or private keys here.
WAYANG_CONSOLE_OIDC_AUTH_SERVER_URL=https://identity.example.com/realms/wayang
WAYANG_CONSOLE_OIDC_ISSUER=https://identity.example.com/realms/wayang
WAYANG_CONSOLE_OIDC_CLIENT_ID=wayang-console
WAYANG_CONSOLE_OIDC_AUDIENCE=wayang-console
